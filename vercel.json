{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/bookings/request", "destination": "/api/bookings?route=bookings-request" },
    { "source": "/api/bookings/respond", "destination": "/api/bookings?route=bookings-respond" },
    { "source": "/api/bookings/cancel", "destination": "/api/bookings?route=bookings-cancel" },
    { "source": "/api/bookings/completion", "destination": "/api/bookings?route=bookings-completion" },
    { "source": "/api/bookings/otp", "destination": "/api/bookings?route=bookings-otp" },
    { "source": "/api/bookings/disputes", "destination": "/api/bookings?route=bookings-disputes" },
    { "source": "/api/bookings/dispute-evidence", "destination": "/api/bookings?route=bookings-dispute-evidence" },
    { "source": "/api/my-bookings", "destination": "/api/bookings?route=bookings-mine" },
    { "source": "/api/host/onboarding", "destination": "/api/host?route=host-onboarding" },
    { "source": "/api/host/verification-document", "destination": "/api/host?route=host-verification-document" },
    { "source": "/api/host/listings/photo", "destination": "/api/host?route=host-listing-photo" },
    { "source": "/api/host/listings/submit", "destination": "/api/host?route=host-listing-submit" },
    { "source": "/api/host/listings", "destination": "/api/host?route=host-listings-create" },
    { "source": "/api/admin/listings/review", "destination": "/api/admin?route=admin-listings-review" },
    { "source": "/api/admin/hosts/review", "destination": "/api/admin?route=admin-hosts-review" },
    { "source": "/api/admin/disputes/resolve", "destination": "/api/admin?route=admin-disputes-resolve" },
    { "source": "/api/payments/initialize", "destination": "/api/payments?route=payments-initialize" },
    { "source": "/api/payments/status", "destination": "/api/payments?route=payments-status" },
    { "source": "/api/amenities", "destination": "/api/platform?route=platform-amenities" },
    { "source": "/api/availability", "destination": "/api/platform?route=platform-availability" },
    { "source": "/api/reviews", "destination": "/api/platform?route=platform-reviews" },
    { "source": "/api/settings", "destination": "/api/platform?route=platform-settings" },
    { "source": "/api/me", "destination": "/api/account?route=account-me" },
    { "source": "/api/dashboard", "destination": "/api/account?route=account-dashboard" },
    { "source": "/api/favorites", "destination": "/api/account?route=account-favorites" },
    { "source": "/api/contact", "destination": "/api/account?route=account-contact" },
    { "source": "/api/listings/:slug", "destination": "/api/listings?route=listings-detail&slug=:slug" },
    { "source": "/api/bookings/:id", "destination": "/api/bookings?route=bookings-detail&id=:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/marketplace-maintenance", "schedule": "0 0 * * *" }
  ]
}
